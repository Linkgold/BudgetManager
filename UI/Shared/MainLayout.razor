@inherits LayoutComponentBase
@inject IThemeService ThemeService

<div class="page @(ThemeService.IsDark ? "dark-theme" : "light-theme")">
    @if (_isLoading)
    {
        <div class="global-loader-overlay">
            <div class="loader-bar"></div>
            <div class="loader-text blink-text">@_loadingMessage</div>
        </div>
    }
    <div class="sidebar">
        <AuthorizeView>
            <Authorized>
                <NavMenu />
            </Authorized>
        </AuthorizeView>
    </div>
    <ToastContainer />
    <main>
        <div class="top-row px-4"></div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>