@page "/categories"
@using Contracts.Enums
@attribute [Authorize]
@inherits BasePage

<div class="container mt-3">
    <!-- 🔹 Título y botón de acción -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <h4 class="mb-0 page-title">📂 Categorías</h4>
        <button class="btn btn-primary btn-sm" @onclick="OpenCreateModal">
            ➕ Nueva Categoría
        </button>
    </div>

    <!-- 🔹 Contenedort de Modal -->
    <div class="table-card-wrapper">
        <!-- 🔹 Filtros y búsqueda -->
        <div class="card filter-card mb-3">
            <div class="card-body d-flex flex-wrap align-items-center gap-2">
                <div style="flex: 1; min-width: 200px; position: relative;">
                    <input type="text" class="form-control form-control-sm search-input-with-clear" placeholder="🔍 Buscar categoría..." @bind="searchTerm" @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(searchTerm))
                    {
                        <span class="search-clear-btn" @onclick="ClearSearch" title="Limpiar búsqueda">✕</span>
                    }
                </div>
                <div style="min-width: 130px; flex-shrink: 0;">
                    <select class="form-control form-control-sm" @bind="selectedNatureFilter">
                        <option value="">Todas</option>
                        <option value="@CategoryNatureEnum.Expense">💳 Gasto</option>
                        <option value="@CategoryNatureEnum.Income">💰 Ingreso</option>
                        <option value="@CategoryNatureEnum.Mixed">🔄 Mixto</option>
                    </select>
                </div>
            </div>
        </div>
        <!-- Modal para crear/editar/eliminar categoría -->
        <Modal Title="@GetModalTitle()"
               IsVisible="@isModalOpen"
               IsDeleteMode="@isDeleteMode"
               OnSave="@SaveCategory"
               OnClose="@CloseModal"
               SaveButtonText="@GetSaveButtonText()"
               SaveButtonClass="@GetSaveButtonClass()">

            <div class="row">
                <!-- Columna izquierda: Nombre -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Nombre</label>
                        <input type="text" class="form-control" @bind="categoryForm.Name" disabled="@isDeleteMode" placeholder="Ej. Alimentación" />
                    </div>
                </div>

                <!-- Columna derecha: Naturaleza -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Naturaleza</label>
                        <select class="form-control" @bind="categoryForm.Nature" disabled="@isDeleteMode">
                            <option value="@CategoryNatureEnum.Expense">💳 Gasto</option>
                            <option value="@CategoryNatureEnum.Income">💰 Ingreso</option>
                            <option value="@CategoryNatureEnum.Mixed">🔄 Mixto</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Fila completa: Descripción -->
            <div class="row mt-2">
                <div class="col-12">
                    <div class="form-group">
                        <label class="form-label">Descripción</label>
                        <input type="text" class="form-control" @bind="categoryForm.Description" disabled="@isDeleteMode" placeholder="Ej. Gastos de comida" />
                    </div>
                </div>
            </div>
        </Modal>
    
        <!-- 🔹 Tabla de categorías -->
        <div class="card table-card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="data-table table table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="text-start">Nombre</th>
                                <th class="text-start">Descripción</th>
                                <th class="text-center">Naturaleza</th>
                                <th class="text-end" style="width: 120px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (filteredCategories.Any())
                            {
                                @foreach (var category in filteredCategories)
                                {
                                    <tr>
                                        <td class="text-start">@category.Name</td>
                                        <td class="text-start">@category.Description</td>
                                        <td class="text-center">
                                            <span class="badge @GetNatureBadgeClass(category.Nature)">
                                                @GetNatureDisplayName(category.Nature)
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => OpenEditModal(category)">
                                                ✏️
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteCategory(category.Id)">
                                                🗑️
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">
                                        No hay categorías que coincidan con los filtros.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer text-muted small">
                Mostrando @filteredCategories.Count() de @categories.Count() categorías
            </div>
        </div>
    </div>
</div>