@page "/"
@attribute [Authorize]
@inherits BasePage

<div class="container-fluid mt-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <h4 class="mb-0 dashboard-title">📈 Resumen Anual @_currentYear</h4>
        <a href="/monthly" class="btn btn-outline-primary btn-sm">📅 Ver mes actual</a>
    </div>

    <div class="card dashboard-card">
        <div class="card-header dashboard-card-header py-2">
            <small class="fw-bold">📊 Presupuestos vs Gastos reales por categoría</small>
        </div>
        <div class="card-body p-0">
            <div class="dashboard-table-wrapper">
                <table class="dashboard-table">
                    <thead>
                        <tr>
                            <th class="text-start">Categoría</th>
                            @foreach (var month in _months)
                            {
                                <th class="text-center">
                                    <span class="d-none d-md-inline">@month.Name</span>
                                    <span class="d-inline d-md-none">@month.ShortName</span>
                                </th>
                            }
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in _dashboardData.Categories)
                        {
                            <tr>
                                <td class="text-start fw-semibold">@category.CategoryName</td>
                                @foreach (var month in _months)
                                {
                                    var data = category.MonthlyData.TryGetValue(month.Value, out var value) ? value : null;
                                    <td class="text-center">
                                        @if (data != null && (data.Budget > 0 || data.Spent > 0))
                                        {
                                            <div>
                                                <span class="@(data.Spent <= data.Budget ? "text-success" : "text-danger")">
                                                    @CurrencyHelper.FormatCurrency(data.Spent)
                                                </span>
                                            </div>
                                            <div>
                                                <span class="fw-bold">@CurrencyHelper.FormatCurrency(data.Budget)</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                }
                                <td class="text-end">
                                    <div>
                                        <span class="@(category.TotalSpent <= category.TotalBudget ? "text-success" : "text-danger")">
                                            @CurrencyHelper.FormatCurrency(category.TotalSpent)
                                        </span>
                                    </div>
                                    <div>
                                        <span class="fw-bold">@CurrencyHelper.FormatCurrency(category.TotalBudget)</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <!-- Fila TOTAL MES -->
                        <tr class="fw-bold">
                            <td class="text-start">TOTAL MES</td>
                            @foreach (var month in _months)
                            {
                                var totalBudget = _dashboardData.Months.FirstOrDefault(m => m.Month == month.Value)?.TotalBudget ?? 0;
                                var totalSpent = _dashboardData.Months.FirstOrDefault(m => m.Month == month.Value)?.TotalSpent ?? 0;
                                <td class="text-center">
                                    <div>
                                        <span class="@(totalSpent <= totalBudget ? "text-success" : "text-danger")">
                                            @CurrencyHelper.FormatCurrency(totalSpent)
                                        </span>
                                    </div>
                                    <div>
                                        <span class="fw-bold">@CurrencyHelper.FormatCurrency(totalBudget)</span>
                                    </div>
                                </td>
                            }
                            <td class="text-end">
                                <div>
                                    <span class="@(_dashboardData.TotalSpent <= _dashboardData.TotalBudget ? "text-success" : "text-danger")">
                                        @CurrencyHelper.FormatCurrency(_dashboardData.TotalSpent)
                                    </span>
                                </div>
                                <div>
                                    <span class="fw-bold">@CurrencyHelper.FormatCurrency(_dashboardData.TotalBudget)</span>
                                </div>
                            </td>
                        </tr>

                        <!-- Fila ACUMULADO -->
                        <tr class="fw-bold">
                            <td class="text-start">ACUMULADO</td>
                            @{
                                decimal acumuladoBudget = 0;
                                decimal acumuladoSpent = 0;
                            }
                            @foreach (var month in _months)
                            {
                                var totalBudget = _dashboardData.Months.FirstOrDefault(m => m.Month == month.Value)?.TotalBudget ?? 0;
                                var totalSpent = _dashboardData.Months.FirstOrDefault(m => m.Month == month.Value)?.TotalSpent ?? 0;
                                acumuladoBudget += totalBudget;
                                acumuladoSpent += totalSpent;
                                <td class="text-center">
                                    <div>
                                        <span class="@(acumuladoSpent <= acumuladoBudget ? "text-success" : "text-danger")">
                                            @CurrencyHelper.FormatCurrency(acumuladoSpent)
                                        </span>
                                    </div>
                                    <div>
                                        <span class="fw-bold">@CurrencyHelper.FormatCurrency(acumuladoBudget)</span>
                                    </div>
                                </td>
                            }
                            <td class="text-end">
                                <div>
                                    <span class="@(_dashboardData.TotalSpent <= _dashboardData.TotalBudget ? "text-success" : "text-danger")">
                                        @CurrencyHelper.FormatCurrency(_dashboardData.TotalSpent)
                                    </span>
                                </div>
                                <div>
                                    <span class="fw-bold">@CurrencyHelper.FormatCurrency(_dashboardData.TotalBudget)</span>
                                </div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>