@page "/"
@using UI.Extensions
@using UI.Models.Dashboard
@attribute [Authorize]
@inherits BasePage

<div class="container mt-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <h4 class="mb-0 dashboard-title">📈 Resumen Anual @_currentYear</h4>
        <a href="/monthly" class="btn btn-outline-primary btn-sm">📅 Ver mes actual</a>
    </div>

    <div class="card dashboard-card">
        <div class="card-header dashboard-card-header py-2">
            <small class="fw-bold">📊 Gastos reales vs Presupuestos por Categoría</small>
        </div>
        <div class="card-body p-0">
            <div class="dashboard-table-wrapper">
                <table class="dashboard-table">
                    <thead>
                        <tr>
                            <th class="text-center">Categoría</th>
                            @foreach (MonthModel month in _months)
                            {
                                <th class="text-center">
                                    <span class="d-none d-md-inline">@month.Name</span>
                                    <span class="d-inline d-md-none">@month.ShortName</span>
                                </th>
                            }
                            <th class="text-center">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (DashboardCategoryRow category in _dashboardData.Categories)
                        {
                            <tr>
                                <td class="text-start">
                                    <div>
                                        <span class="badge @category.Nature.GetBadgeClass()">
                                            <span class="nature-icon">@category.Nature.GetIcon()</span>
                                            @category.Nature.GetDisplayName()
                                        </span>
                                    </div>
                                    <div>
                                        <span class="fw-semibold">@category.CategoryName</span>
                                    </div>
                                </td>
                                @foreach (MonthModel month in _months)
                                {
                                    DashboardMonthData? data = category.MonthlyData.TryGetValue(month.Value, out DashboardMonthData? value) ? value : null;
                                    <td class="category-cell text-center">
                                        @if (data != null && (data.Budget > 0 || data.Spent > 0))
                                        {
                                            <div>
                                                <span class="@category.Nature.GetStatusClass(data.Spent, data.Budget)">
                                                    @CurrencyHelper.FormatCurrency(data.Spent)
                                                </span>
                                            </div>
                                            <div>
                                                <span class="fw-bold">@CurrencyHelper.FormatCurrency(data.Budget)</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted" style="font-size: 0.6rem;">—</span>
                                        }
                                    </td>
                                }
                                <td class="text-end">
                                    <div>
                                        <span class="@category.Nature.GetStatusClass(category.TotalSpent, category.TotalBudget)">
                                            @CurrencyHelper.FormatCurrency(category.TotalSpent)
                                        </span>
                                    </div>
                                    <div>
                                        <span class="fw-bold">@CurrencyHelper.FormatCurrency(category.TotalBudget)</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <!-- Fila TOTAL MES -->
                        <tr class="table-secondary fw-bold">
                            <td class="text-start">TOTAL MES</td>
                            @foreach (DashboardMonthColumn month in _dashboardData.Months)
                            {
                                <td class="text-center">
                                    <div>
                                        <span class="@month.TotalSpent.GetDisplayClass()">
                                            @CurrencyHelper.FormatCurrency(month.TotalSpent)
                                        </span>
                                    </div>
                                    <div>
                                        <!-- ✅ Color según el signo del valor -->
                                        <span class="@month.TotalBudget.GetDisplayClass()">
                                            @CurrencyHelper.FormatCurrency(month.TotalBudget)
                                        </span>
                                    </div>
                                </td>
                            }
                            <!-- Total general -->
                            <td class="text-end" />
                        </tr>

                        <!-- Fila ACUMULADO -->
                        <tr class="table-secondary fw-bold">
                            <td class="text-start">ACUMULADO</td>
                            @foreach (DashboardAccumulatedMonth accumulated in _dashboardData.AccumulatedMonths)
                            {
                                <td class="text-center">
                                    <div>
                                        <span class="@accumulated.AcumuladoSpent.GetDisplayClass()">
                                            @CurrencyHelper.FormatCurrency(accumulated.AcumuladoSpent)
                                        </span>
                                    </div>
                                    <div>
                                        <span class="@accumulated.AcumuladoBudget.GetDisplayClass()">
                                            @CurrencyHelper.FormatCurrency(accumulated.AcumuladoBudget)
                                        </span>
                                    </div>
                                </td>
                            }
                            <!-- Total general -->
                            <td class="text-end" />
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>