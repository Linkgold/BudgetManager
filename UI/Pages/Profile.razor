@page "/profile"
@attribute [Authorize]
@inherits BasePage

<div class="container mt-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <h4 class="mb-0 page-title">👤 Mi Perfil</h4>
    </div>

    <div class="row">
        <div class="col-md-8 offset-md-2">
            <!-- 1. Información Personal -->
            <div class="card profile-card">
                <div class="card-header profile-card-header">
                    <span>Información Personal</span>
                </div>
                <div class="card-body">
                    @if (_isLoading)
                    {
                        <div class="text-center py-4">
                            <span>Cargando...</span>
                        </div>
                    }
                    else
                    {
                        <div class="form-group">
                            <label class="form-label">Nombre de usuario</label>
                            <input type="text" class="form-control" @bind="_userName" @bind:event="oninput" placeholder="Tu nombre" />
                        </div>

                        <div class="form-group mt-2">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" @bind="_email" @bind:event="oninput" placeholder="usuario@email.com" />
                        </div>

                        <div class="form-group mt-2">
                            <label class="form-label">Fecha de registro</label>
                            <input type="text" class="form-control input-disabled" value="@_createdAt.ToString("dd/MM/yyyy HH:mm")" disabled />
                        </div>

                        <div class="mt-3 d-flex gap-2">
                            <button class="btn btn-primary btn-sm" @onclick="SaveProfile" disabled="@(!HasChanges)">
                                💾 Guardar cambios
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="CancelChanges" disabled="@(!HasChanges)">
                                ❌ Cancelar
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- 2. Seguridad -->
            <div class="card profile-card mt-3">
                <div class="card-header profile-card-header">
                    <span>🔐 Seguridad</span>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label class="form-label">Contraseña actual</label>
                        <input type="password" class="form-control password-reveal" @bind="_currentPassword" @bind:event="oninput" placeholder="********" />
                    </div>

                    <div class="form-group mt-2">
                        <label class="form-label">Nueva contraseña</label>
                        <input type="password" class="form-control password-reveal" @bind="_newPassword" @bind:event="oninput" placeholder="********" />
                    </div>

                    <div class="form-group mt-2">
                        <label class="form-label">Confirmar nueva contraseña</label>
                        <input type="password" class="form-control password-reveal" @bind="_confirmNewPassword" @bind:event="oninput" placeholder="********" />
                    </div>

                    @if (!string.IsNullOrEmpty(_newPassword) || !string.IsNullOrEmpty(_confirmNewPassword))
                    {
                        <div class="password-validation-message @(PasswordsMatch ? "password-match" : "password-mismatch")">
                            @(PasswordsMatch ? "✅ Las contraseñas coinciden" : "❌ Las contraseñas no coinciden")
                        </div>
                    }

                    <div class="mt-3 d-flex gap-2">
                        <button class="btn btn-warning btn-sm" @onclick="ChangePassword" disabled="@(!CanChangePassword)">
                            🔄 Cambiar contraseña
                        </button>
                    </div>
                </div>
            </div>

            <!-- 3. Eliminar cuenta -->
            <div class="card profile-card danger-card mt-3">
                <div class="card-header profile-card-header-danger">
                    <span>🗑️ Eliminar cuenta</span>
                </div>
                <div class="card-body">
                    <p class="danger-text small">Eliminar tu cuenta es irreversible. Todos tus datos se perderán.</p>
                    <button class="btn btn-danger btn-sm" @onclick="OpenDeleteConfirmation">
                        🗑️ Eliminar cuenta
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de confirmación para eliminar cuenta -->
<ConfirmModal IsVisible="@_isDeleteModalOpen"
              Title="Eliminar cuenta"
              Message="¿Estás seguro de que quieres eliminar tu cuenta? Esta acción no se puede deshacer y todos tus datos se perderán."
              ConfirmButtonText="Eliminar"
              OnConfirm="@ConfirmDelete"
              OnCancel="@CancelDelete" />