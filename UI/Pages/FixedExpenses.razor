@page "/fixedexpenses"
@attribute [Authorize]
@inherits BasePage

<div class="container mt-3">
    <!-- Título y botón -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <h4 class="mb-0 page-title">📂 Gastos Fijos</h4>
        <button class="btn btn-primary btn-sm" @onclick="OpenCreateModal">
            ➕ Nuevo Gasto Fijo
        </button>
    </div>

    <!-- 🔹 Contenedort de Modal -->
    <div class="table-card-wrapper">
        <!-- Filtros -->
        <div class="card filter-card mb-3">
            <div class="card-body d-flex flex-wrap align-items-center gap-2">
                <!-- Búsqueda -->
                <div style="flex: 1; min-width: 150px; position: relative;">
                    <input type="text" class="form-control form-control-sm search-input-with-clear"
                           placeholder="🔍 Buscar..."
                           @bind="searchTerm"
                           @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(searchTerm))
                    {
                        <span class="search-clear-btn" @onclick="ClearSearch" title="Limpiar búsqueda">✕</span>
                    }
                </div>

                <!-- Filtro por categoría -->
                <div style="min-width: 150px;">
                    <select class="form-control form-control-sm" @bind="selectedCategoryId">
                        <option value="0">Todas las categorías</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                </div>

                <!-- Filtro por año -->
                <div style="min-width: 120px;">
                    <select class="form-control form-control-sm" @bind="selectedYear">
                        <option value="0">Todos los años</option>
                        @foreach (var year in years)
                        {
                            <option value="@year">@year</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- Modal -->
        <Modal Title="@fixedExpenseForm.CurrentMode.GetModalTitle("Gasto Fijo")"
               IsVisible="@fixedExpenseForm.IsModalOpen"
               IsDeleteMode="@fixedExpenseForm.IsDeleting"
               OnSave="@SaveFixedExpense"
               OnClose="@CloseModal"
               SaveButtonText="@fixedExpenseForm.SaveButtonText"
               SaveButtonClass="@fixedExpenseForm.SaveButtonClass">

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label" for="fixedExpenseName">Nombre</label>
                        <input type="text" id="fixedExpenseName" class="form-control" @bind="fixedExpenseForm.Name" disabled="@fixedExpenseForm.IsDeleting" placeholder="Ej. IBI" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label" for="fixedExpenseAmount">Importe (€)</label>
                        <input type="number" id="fixedExpenseAmount" class="form-control" @bind="fixedExpenseForm.Amount" step="0.01" min="0" disabled="@fixedExpenseForm.IsDeleting" placeholder="0.00" />
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label" for="fixedExpenseCategory">Categoría</label>
                        <select id="fixedExpenseCategory" class="form-control" @bind="fixedExpenseForm.CategoryId" disabled="@fixedExpenseForm.IsDeleting">
                            @foreach (var category in categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label" for="fixedExpenseMonth">Mes</label>
                        <select id="fixedExpenseMonth" class="form-control" @bind="fixedExpenseForm.Month" disabled="@fixedExpenseForm.IsDeleting">
                            @foreach (var month in MonthHelper.Months)
                            {
                                <option value="@month.Value">@month.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label" for="fixedExpenseYear">Año</label>
                        <select id="fixedExpenseYear" class="form-control" @bind="fixedExpenseForm.Year" disabled="@fixedExpenseForm.IsDeleting">
                            @foreach (var year in years)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-12">
                    <div class="form-group">
                        <label class="form-label" for="fixedExpenseDescription">Descripción</label>
                        <input type="text" id="fixedExpenseDescription" class="form-control" @bind="fixedExpenseForm.Description" disabled="@fixedExpenseForm.IsDeleting" placeholder="Ej. Impuesto sobre bienes inmuebles" />
                    </div>
                </div>
            </div>
        </Modal>

        <!-- Tabla -->
        <div class="card table-card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="data-table table table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="text-start">Categoría</th>
                                <th class="text-start">Nombre</th>
                                <th class="text-start">Descripción</th>
                                <th class="text-end">Importe</th>
                                <th class="text-center">Mes</th>
                                <th class="text-center">Año</th>
                                <th class="text-end" style="width: 100px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (filteredFixedExpenses.Any())
                            {
                                @foreach (var item in filteredFixedExpenses)
                                {
                                    <tr>
                                        <td class="text-start">@item.CategoryName</td>
                                        <td class="text-start">@item.Name</td>
                                        <td class="text-start">@item.Description</td>
                                        <td class="text-end">@CurrencyHelper.FormatCurrency(item.Amount)</td>
                                        <td class="text-center">@MonthHelper.GetMonthName(item.Month)</td>
                                        <td class="text-center">@item.Year</td>
                                        <td class="text-end">
                                            <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => OpenEditModal(item)">
                                                ✏️
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => OpenDeleteModal(item)">
                                                🗑️
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-3">
                                        No hay gastos fijos que coincidan con los filtros.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer text-muted small">
                Mostrando @filteredFixedExpenses.Count() de @fixedExpenses.Count() gastos fijos
            </div>
        </div>
    </div>
</div>